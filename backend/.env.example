# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/lms-saas

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5174

# Stripe Keys
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# JazzCash Keys (Pakistan Payment)
JAZZCASH_MERCHANT_ID=your_merchant_id
JAZZCASH_PASSWORD=your_password
JAZZCASH_INTEGRITY_CHECK_KEY=your_integrity_key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket_name

# OpenAI API (for chatbot/AI features)
OPENAI_API_KEY=your_openai_api_key

# Admin Default Email
ADMIN_EMAIL=admin@learnsmart.com

# Pagination
ITEMS_PER_PAGE=10

# Session Secret
SESSION_SECRET=your_session_secret_here
